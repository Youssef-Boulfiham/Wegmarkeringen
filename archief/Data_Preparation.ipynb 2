    "import pandas as pd\n",
    "import geopandas as gpd\n",
    "from shapely.geometry import Point, LineString, MultiLineString\n",
    "\n",
    "df = hectopunten.copy()\n",
    "\n",
    "\n",
    "# =========================\n",
    "# PARSERS\n",
    "# =========================\n",
    "\n",
    "# --------\n",
    "# PUNT\n",
    "# --------\n",
    "def parse_point(s):\n",
    "    if pd.isna(s):\n",
    "        return None\n",
    "    try:\n",
    "        x, y = map(float, s.split(\",\"))\n",
    "        return Point(x, y)\n",
    "    except:\n",
    "        return None\n",
    "\n",
    "\n",
    "# --------\n",
    "# LIJN (flat: \"x, y, x, y\")\n",
    "# --------\n",
    "def parse_line_flat(s):\n",
    "    if pd.isna(s):\n",
    "        return None\n",
    "    try:\n",
    "        nums = [float(x.strip()) for x in s.split(\",\")]\n",
    "        coords = list(zip(nums[::2], nums[1::2]))\n",
    "        if len(coords) < 2:\n",
    "            return None\n",
    "        return LineString(coords)\n",
    "    except:\n",
    "        return None\n",
    "\n",
    "\n",
    "# --------\n",
    "# LIJN RD (\"x y, x y\")\n",
    "# --------\n",
    "def parse_line_rd(s):\n",
    "    if pd.isna(s):\n",
    "        return None\n",
    "    try:\n",
    "        coords = []\n",
    "        for pair in s.split(\",\"):\n",
    "            x, y = map(float, pair.strip().split())\n",
    "            coords.append((x, y))\n",
    "        if len(coords) < 2:\n",
    "            return None\n",
    "        return LineString(coords)\n",
    "    except:\n",
    "        return None\n",
    "\n",
    "\n",
    "# --------\n",
    "# MULTILINESTRING\n",
    "# --------\n",
    "def parse_multiline(s):\n",
    "    if pd.isna(s):\n",
    "        return None\n",
    "\n",
    "    try:\n",
    "        s = s.replace(\"MULTILINESTRING ((\", \"\").replace(\"))\", \"\")\n",
    "        lines_raw = s.split(\"), (\")\n",
    "\n",
    "        lines = []\n",
    "\n",
    "        for line in lines_raw:\n",
    "            coords = []\n",
    "\n",
    "            for pair in line.split(\",\"):\n",
    "                x, y = map(float, pair.strip().split())\n",
    "                coords.append((x, y))\n",
    "\n",
    "            if len(coords) >= 2:\n",
    "                lines.append(LineString(coords))\n",
    "\n",
    "        if len(lines) == 0:\n",
    "            return None\n",
    "\n",
    "        if len(lines) == 1:\n",
    "            return lines[0]\n",
    "\n",
    "        return MultiLineString(lines)\n",
    "\n",
    "    except:\n",
    "        return None\n",
    "\n",
    "\n",
    "# --------\n",
    "# INSPECTIES → punten\n",
    "# --------\n",
    "def parse_ins_points(s):\n",
    "\n",
    "    if pd.isna(s):\n",
    "        return []\n",
    "\n",
    "    try:\n",
    "        parts = s.split(\"LINESTRING\")\n",
    "        points = []\n",
    "\n",
    "        for part in parts:\n",
    "\n",
    "            if \"(\" not in part:\n",
    "                continue\n",
    "\n",
    "            coords_str = part.split(\"(\")[1].split(\")\")[0]\n",
    "\n",
    "            for pair in coords_str.split(\",\"):\n",
    "                x, y = map(float, pair.strip().split())\n",
    "                points.append(Point(x, y))\n",
    "\n",
    "        return points\n",
    "\n",
    "    except:\n",
    "        return []\n",
    "\n",
    "\n",
    "# =========================\n",
    "# 1 HECTOPUNTEN\n",
    "# =========================\n",
    "\n",
    "df_hecto = df.copy()\n",
    "\n",
    "df_hecto[\"geometry\"] = df_hecto[\"hectopunt_rd_coordinaten\"].apply(parse_point)\n",
    "\n",
    "gdf_hecto = gpd.GeoDataFrame(\n",
    "    df_hecto,\n",
    "    geometry=\"geometry\",\n",
    "    crs=\"EPSG:28992\"\n",
    ").dropna(subset=[\"geometry\"])\n",
    "\n",
