    "\n",
    "\n",
    "# =========================\n",
    "# 2. geometrie simplificeren\n",
    "# =========================\n",
    "print(\"simplify...\")\n",
    "\n",
    "gdf[\"geometry\"] = gdf.geometry.simplify(50)\n",
    "\n",
    "\n",
    "# =========================\n",
    "# 3. buffer rond wegen\n",
