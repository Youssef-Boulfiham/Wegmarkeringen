    "        coords = [pt for line in geom.geoms for pt in line.coords]\n",
    "    else:\n",
    "        return None\n",
    "    gps_pts = [transformer.transform(x, y) for x, y in coords]\n",
    "    return ', '.join(f\"{lat:.6f} {lon:.6f}\" for lon, lat in gps_pts)"
